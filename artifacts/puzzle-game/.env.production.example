# ─── Puzzle X — Production Environment Variables ─────────────────────────────
# Copy this file to .env.production (DO NOT commit .env.production to git)
# These values are baked into the Android APK at build time by Vite.
#
# Get your real AdMob IDs from: https://apps.admob.com
# Apps → Puzzle X → Ad units
# ─────────────────────────────────────────────────────────────────────────────

# AdMob App ID (ca-app-pub-XXXXX~YYYYY format — get from App Settings)
VITE_ADMOB_APP_ID=ca-app-pub-XXXXXXXXXXXXXXXX~XXXXXXXXXX

# Banner ad unit ID
VITE_ADMOB_BANNER_ID=ca-app-pub-XXXXXXXXXXXXXXXX/XXXXXXXXXX

# Interstitial ad unit ID (shown every 5 levels)
VITE_ADMOB_INTERSTITIAL_ID=ca-app-pub-XXXXXXXXXXXXXXXX/XXXXXXXXXX

# Rewarded ad unit ID (watch ad for coins/hints)
VITE_ADMOB_REWARDED_ID=ca-app-pub-XXXXXXXXXXXXXXXX/XXXXXXXXXX
