<!--
  ①  Add these PERMISSIONS inside <manifest>, above <application>:
-->
<uses-permission android:name="android.permission.INTERNET" />
<uses-permission android:name="android.permission.ACCESS_NETWORK_STATE" />

<!-- Required by AdMob for personalised ads -->
<uses-permission android:name="com.google.android.gms.permission.AD_ID" />

<!-- Haptic feedback -->
<uses-permission android:name="android.permission.VIBRATE" />


<!--
  ②  Add these inside the <application> tag.
      Replace the value with your real AdMob App ID before publishing.
      Format: ca-app-pub-XXXXX~YYYYY (from AdMob Console → Apps → App settings)
-->
<meta-data
    android:name="com.google.android.gms.ads.APPLICATION_ID"
    android:value="ca-app-pub-3940256099942544~3347511713" />
<!-- ^^^ TEST ID — replace before publishing to Play Store -->

<!-- Delay app measurement init (GDPR-friendly) -->
<meta-data
    android:name="com.google.android.gms.ads.DELAY_APP_MEASUREMENT_INIT"
    android:value="true" />

<!-- Network security: enforce HTTPS, allow localhost for dev live-reload -->
<meta-data
    android:name="android.security.NETWORK_SECURITY_CONFIG"
    android:resource="@xml/network_security_config" />


